# ============================================================
# ApiEnvios - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# --- APP ---
NODE_ENV=development
PORT=3000
API_SECRET=troque-por-um-secret-forte-aqui
# URL base pública usada para montar a apiUrl de cada instância (estilo UltraMsg)
# Em Docker Compose use o nome do serviço: http://app:3002
PUBLIC_BASE_URL=http://app:3002

# --- AUTENTICAÇÃO HUMANA (login JWT) ---
JWT_SECRET=troque-por-um-jwt-secret-forte-aqui
JWT_EXPIRES_IN=7d

# --- BANCO DE DADOS ---
DATABASE_URL="postgresql://apienvios:senha123@localhost:5432/apienvios"

# --- REDIS (filas e cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- EVOLUTION API (Provider 1 - Principal) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-aqui

# --- WuzAPI (Provider 2 - Go/whatsmeow, botões interativos) ---
WUZAPI_URL=http://localhost:8888
WUZAPI_ADMIN_TOKEN=

# --- WHATSAPP CLOUD API OFICIAL (Provider 3 - Fallback pago) ---
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_BUSINESS_ACCOUNT_ID=

# --- NOTIFICAÇÕES DE BAN ---
# Webhook que será chamado quando um número for banido
BAN_WEBHOOK_URL=
# Email para alertas (opcional)
ALERT_EMAIL=

# --- RATE LIMIT DE LOGIN (3 camadas: conta / ip / dispositivo) ---
LOGIN_MAX_TENTATIVAS_CONTA=5
LOGIN_JANELA_CONTA_MIN=15
LOGIN_MAX_TENTATIVAS_IP=20
LOGIN_JANELA_IP_MIN=15
LOGIN_MAX_TENTATIVAS_DISPOSITIVO=20
LOGIN_JANELA_DISPOSITIVO_MIN=15
# IPs que nunca são bloqueados, separados por vírgula (opcional)
LOGIN_IP_ALLOWLIST=

# --- CONFIGURAÇÕES DE ENVIO ---
# Delay mínimo entre mensagens em ms (anti-ban)
SEND_DELAY_MIN=2000
# Delay máximo entre mensagens em ms (anti-ban)
SEND_DELAY_MAX=5000
# Máximo de mensagens por número por dia antes de rotacionar
MAX_MESSAGES_PER_NUMBER_DAY=200

# --- ADMIN INICIAL DO PAINEL (provisionado pelo seed) ---
# Opcionais. Se ambos (EMAIL e PASSWORD) estiverem vazios/ausentes, a app e o
# seed rodam normalmente e NENHUM admin é criado. Preencha para provisionar um
# usuário admin do painel (vinculado ao ApiClient com role ADMIN). NÃO comite a
# senha real — use valores reais apenas no seu .env local.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrador
